# URL pública do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Chave administrativa usada somente pelas rotas server-side.
# Nunca use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=

# Acesso temporário sem autenticação, bloqueado automaticamente em produção.
ENABLE_INSECURE_DEV_DATABASE_ACCESS=true
